<!-- Main container (Bootstrap layout wrapper) -->
<div class="container">

  <!-- Left column (6/12 width on small screens and up) -->
  <div class="col-sm-6">

    <!-- Error illustration image -->
    <!-- Image should exist in /public/images -->
    <img src="/images/cat.jpg" alt="Error cat">

  </div>

  <!-- Right column (6/12 width on small screens and up) -->
  <div class="col-sm-6">

    <!-- Error message heading -->
    <!-- Displayed when a page is not found or a server error occurs -->
    <h1>
      Oops! Something went wrong, or the page you are looking for is not available.
    </h1>

    <!-- Navigation option to return home -->
    <p>
      Go to
      <!-- Link back to home page -->
      <a href="/">home!</a>
    </p>

  </div>
</div>