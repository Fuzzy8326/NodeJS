<!-- Main container (Bootstrap layout wrapper) -->
<div class="container">

  <!-- Left column (6/12 width on small screens and up) -->
  <div class="col-sm-6">

    <!-- Welcome image -->
    <!-- Make sure this file exists inside /public/images -->
    <img src="images/people.jpg" alt="People cooking together">

  </div>

  <!-- Right column (6/12 width on small screens and up) -->
  <div class="col-sm-6">

    <!-- Welcome heading -->
    <h1>Welcome!</h1>

    <!-- Introductory message -->
    <p>
      Please check out all the cool new courses by our innovative and creative chefs.
    </p>

    <!-- Link to courses page -->
    <!-- Note: If using Express routes, this may need to be "/courses" instead of "/courses.html" -->
    <p>
      If you want to see a new course, click 
      <a href="/courses.html">the courses page</a> 
      and explore!
    </p>

    <!-- Link to contact page -->
    <!-- Note: If using Express routes, this may need to be "/contact" instead of "/contact.html" -->
    <p>
      When you see a course you like you can 
      <a href="/contact.html">contact us to join!</a> 
      Soon you'll be cooking in your own home.
    </p>

  </div>
</div>